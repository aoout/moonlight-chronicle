{
  "name": "moonlight-chronicle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:god": "vite --mode god",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint 'js/**/*.ts'",
    "format": "prettier --write 'js/**/*.ts' 'css/**/*.css'"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
